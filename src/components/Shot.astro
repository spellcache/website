---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  device: 'mobile' | 'desktop';
  alt: string;
  class?: string;
  eager?: boolean;
}

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.{png,jpg,jpeg,webp}', {
  eager: true,
});

const { name, device, alt, class: className, eager = false } = Astro.props;
const image = Object.entries(files).find(([path]) =>
  /\/([^/]+)\.\w+$/.exec(path)?.[1] === `${name}-${device}`,
)?.[1].default;
const size = device === 'mobile' ? '390×844' : '1440×900';
---

<div class:list={['shot', `shot-${device}`, className]}>
  {
    image ? (
      <Image src={image} alt={alt} widths={device === 'mobile' ? [390, 780] : [720, 1440]} sizes={device === 'mobile' ? '(max-width: 600px) 45vw, 260px' : '(max-width: 900px) 100vw, 560px'} loading={eager ? 'eager' : 'lazy'} />
    ) : (
      <span role="img" aria-label={`${alt} (coming soon)`}>
        [Screenshot — {name.replace('-', ' ')}, {device} {size}]
      </span>
    )
  }
</div>

<style>
  .shot-mobile {
    aspect-ratio: 9 / 19.5;
    border-radius: 22px;
    overflow: hidden;
  }

  .shot-desktop {
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
  }

  .shot:has(img) {
    padding: 0;
    background: var(--surface-2);
  }
</style>
