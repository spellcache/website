---
import type { FeatureIcon } from '../data/site';

interface Props {
  name: FeatureIcon;
}

const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'collection' && <><path d="M12 3l9 5-9 5-9-5 9-5z" /><path d="M3 13l9 5 9-5" /></>}
  {name === 'decks' && <><rect x="8" y="3" width="12" height="16" rx="2" /><path d="M4 7v12a2 2 0 0 0 2 2h9" /></>}
  {name === 'value' && <><path d="M3 17l6-6 4 4 8-8" /><path d="M14 7h7v7" /></>}
  {name === 'trading' && <><path d="M4 8h15l-4-4" /><path d="M20 16H5l4 4" /></>}
  {name === 'sharing' && <><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><path d="M16 4.5a3.5 3.5 0 0 1 0 7" /><path d="M18 14a6 6 0 0 1 3.5 6" /></>}
  {name === 'mobile' && <><rect x="6" y="2" width="12" height="20" rx="3" /><path d="M11 18h2" /></>}
</svg>
