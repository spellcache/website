---
import Logo from './Logo.astro';
import { links } from '../data/site';
---

<header class="container header">
  <a href="/" class="brand">
    <Logo />
    <span>spellcache</span>
  </a>
  <nav aria-label="Main" class="nav">
    <a href="/#features">Features</a>
    <a href="/#screenshots">Screenshots</a>
    <a href="/#demo" class="with-badge">Demo <span class="badge">Soon</span></a>
    <a href="/#self-host">Self-host</a>
    <a href={links.docs}>Docs</a>
    <a href={links.repo} class="github">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path></svg>
      GitHub
    </a>
  </nav>
</header>

<style>
  .header {
    padding-block: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.5px;
  }

  .brand:hover {
    color: var(--text);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
    font-size: 15px;
  }

  .nav a {
    color: var(--text-2);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--text);
  }

  .with-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .badge {
    padding: 1px 6px;
    border-radius: 6px;
    border: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .nav .github {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    color: var(--text);
    font-weight: 500;
  }

  .nav .github:hover {
    border-color: var(--text-3);
  }
</style>
